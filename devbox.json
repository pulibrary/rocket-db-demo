{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "git@latest",
    "lastpass-cli",
    "bash@latest",
    "rustup@latest",
    "openssl",
    "postgresql@latest"
  ],
  "shell": {
    "init_hook": [
      "cargo fetch",
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "setup": [
        "test -f \"$PGDATA/PG_VERSION\" || initdb",
        "cargo compile"
      ],
      "test": [
        "devbox run setup",
        "cargo test"
      ]
    }
  }
}
